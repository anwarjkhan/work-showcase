{
  "name": "delivery-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Delivery intelligence prototype over synthetic data. Static export, no network.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev",
